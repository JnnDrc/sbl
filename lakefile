-- this is the script of my build system, ignore it
local cc = "gcc"
local cflags = " -Wall " .. " -Wextra" .. " -g " .. "-I./src " .. "-O3 "

local src_dir  = "src/"
local files = {"sblinst.c", "sblconst.c", "sblstack.c", "sblop.c", "sblvm.c"}

local src = ""
for i, s in ipairs(files) do
    src = src .. src_dir .. s .. ' '
end

local sblc_src = src_dir .. "sblc.c " .. src
local sbl_src  = src_dir .. "sbl.c "  .. src
local sbli_src = src_dir .. "sbli.c "  .. src

lake.task("sblc"):cmd(cc,cflags,sblc_src, "-o sblc")
lake.task("sbli"):cmd(cc,cflags,sbli_src, "-o sbli")
lake.task("sbl"):cmd(cc,cflags,sbl_src, "-o sbl")


if arg[1] == "sblc" then
    lake.run("sblc")
elseif arg[1] == "sbli" then
    lake.run("sbli")
elseif arg[1] == "sbl" then
    lake.run("sbl")
elseif arg[1] == 'all' then
    lake.run("sbl")
    lake.run("sblc")
    lake.run("sbli")
else
    print("unknown task, tasks:" .. lake.list())
end
